// Declare OTLP Receiver to accept data from the Java Agent
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.exporter.prometheus.mimir.input]
    logs    = [otelcol.exporter.loki.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Convert and route OTLP metrics to Mimir / Prometheus endpoint
otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://lgtm:9090/api/v1/write"
  }
}

// Route OTLP logs directly to Loki
otelcol.exporter.loki "loki" {
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}

// Forward OTLP traces to Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "lgtm:4317"
    tls {
      insecure = true
    }
  }
}
